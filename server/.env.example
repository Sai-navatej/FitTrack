# FitTrack Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fittrack?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173
