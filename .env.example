# FitTrack Backend Configuration
# Copy this file to server/.env and fill in your values

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://sainavatej5294_db_user:abVGGufuHcp1qQCT@<cluster>.mongodb.net/fittrack?retryWrites=true&w=majority

# Optional: Dedicated test database URI (defaults to /fittrack_test on Atlas if omitted)
# TEST_MONGODB_URI=

# JWT Secret Key (Generate a random 32+ character string)
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin (Allowed for CORS and cookies)
CLIENT_URL=http://localhost:5173
