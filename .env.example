# FitTrack Global Configuration Example
# Copy this to server/.env or configure each directory as needed

# Backend Server (server/.env)
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas connection string below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fittrack?retryWrites=true&w=majority
# If left blank, FitTrack will automatically launch an embedded in-memory MongoDB instance for local testing
MONGODB_URI=

# JWT Secret Key
JWT_SECRET=fittrack_super_secure_jwt_secret_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173
